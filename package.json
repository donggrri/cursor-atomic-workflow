{
  "name": "matt-pocock-atomic-workflow",
  "version": "0.1.0",
  "description": "Atomic explore → plan → task → execute → review → commit workflow for Pi, Cursor, OpenCode, Claude Code, and Codex.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donggrri/matt-pocock-atomic-workflow.git"
  },
  "homepage": "https://github.com/donggrri/matt-pocock-atomic-workflow#readme",
  "bugs": {
    "url": "https://github.com/donggrri/matt-pocock-atomic-workflow/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "workflow",
    "atomic-workflow",
    "skills",
    "agents"
  ],
  "files": [
    "agents/",
    "prompts/",
    "skills/",
    "scripts/",
    ".cursor/",
    ".opencode/",
    ".claude/",
    "settings.example.json",
    "README.md",
    "README.kr.md",
    "THIRD_PARTY_LICENSES/",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "status": "node scripts/work-status.mjs",
    "doctor": "node scripts/doctor.mjs",
    "sync": "node scripts/sync-harness.mjs",
    "sync:check": "node scripts/sync-harness.mjs --check",
    "install:harness": "node scripts/install.mjs"
  },
  "pi": {
    "skills": ["./skills"],
    "prompts": ["./prompts"],
    "subagents": { "agents": ["./agents"] }
  }
}
